# For local `pnpm dev`, point this at whatever Postgres you use locally.
# For `docker compose` deployments, point this at the `db` service instead,
# e.g. postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=""

QR_SCAN_IP_SALT=""

# Used by compose.yml to configure the `db` service (must match the
# credentials/db name embedded in DATABASE_URL above when deploying via compose).
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Used by compose.yml to select which built image to pull/run.
DOCKER_REGISTRY="ghcr.io/isaacvarg"
DOCKER_IMAGE_NAME="rancholostecolotes"
IMAGE_TAG="latest"
